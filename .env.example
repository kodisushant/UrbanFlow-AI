# UrbanFlow AI - Environment Configuration Template
# Copy this file to .env and fill in your values
# DO NOT commit .env with real secrets to Git

# 1. GitHub MCP Server Integration (Optional, for GitHub MCP tools)
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_github_personal_access_token_here

# 2. LLM Provider API Keys (Optional, if connecting live cloud agents)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# 3. Backend System Settings
DEMO_OPERATOR_ID=DISPATCHER_LEAD_01
PORT=8000
VITE_API_URL=http://localhost:8000/api/v1
